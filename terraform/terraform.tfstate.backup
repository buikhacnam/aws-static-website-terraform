    {
      "module": "module.cloudfront",
      "mode": "managed",
      "type": "aws_cloudfront_function",
      "name": "redirect_apex_to_www",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::933822101074:function/casey-click-redirect-apex-to-www",
            "code": "function handler(event) {\n    var request = event.request;\n    var host = request.headers.host.value;\n    \n    // If request is for apex domain, redirect to www\n    if (host === 'casey.click') {\n        var response = {\n            statusCode: 301,\n            statusDescription: 'Moved Permanently',\n            headers: {\n                'location': { value: 'https://www.casey.click' + request.uri }\n            }\n        };\n        return response;\n    }\n    \n    // Otherwise, continue with request\n    return request;\n}\n",
            "comment": "Redirect apex domain to www subdomain",
            "etag": "ETVPDKIKX0DER",
            "id": "casey-click-redirect-apex-to-www",
            "key_value_store_associations": [],
            "live_stage_etag": "ETVPDKIKX0DER",
